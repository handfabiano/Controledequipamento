# Porta do servidor
PORT=3001

# Chave secreta do JWT — OBRIGATÓRIA em produção (o servidor não sobe sem ela)
JWT_SECRET=sua_chave_secreta_aqui_mude_em_producao

# Ambiente: development | production
NODE_ENV=development

# Banco de dados Postgres (produção). Se não definido, usa SQLite local.
# Exemplo Supabase (connection pooler): postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# Origens permitidas para CORS, separadas por vírgula (recomendado em produção)
# CORS_ORIGIN=https://seu-app.vercel.app

# Seed de dados de demonstração (usuários de teste com senha 123456).
# Padrão: só com NODE_ENV=development ou test; sem NODE_ENV e em produção NÃO semeia.
# SEED_DEMO_DATA=true força o seed (nunca em produção real); =false desliga em desenvolvimento.
# SEED_DEMO_DATA=false

# Segredo exigido (cabeçalho X-Bootstrap-Token) no PRIMEIRO cadastro, com o banco sem usuários.
# Recomendado em produção; sem ele, quem chamar POST /api/auth/register primeiro vira coordenador.
# BOOTSTRAP_TOKEN=

# Proxy reverso: número de proxies confiáveis à frente do app (necessário para o rate limit
# enxergar o IP real). Padrão: 1 na Vercel, desligado nos demais ambientes.
# TRUST_PROXY=1

# Limites por IP a cada 15 minutos
# RATE_LIMIT_MAX=300
# LOGIN_RATE_LIMIT_MAX=5
